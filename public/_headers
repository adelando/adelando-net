# Cloudflare response headers.
# Fingerprinted CSS/JS and the font never change, so browsers may keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=604800
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Dev previews: every push to a non-production branch publishes a throwaway copy
# of the site at <branch>.adelando.net (dev.adelando.net for the dev branch) and
# on workers.dev. Keep those copies out of search results. Cloudflare adds this
# header itself on workers.dev but not on custom domains. The live site at
# adelando.net is untouched, and www simply points search engines at adelando.net.
https://:preview.adelando.net/*
  X-Robots-Tag: noindex
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
